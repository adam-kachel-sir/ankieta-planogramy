generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Jedna wysłana ankieta = jeden wiersz. Bez imienia, maila i adresu IP.
model Odpowiedz {
  id        Int      @id @default(autoincrement())
  utworzono DateTime @default(now())
  ankieta   String   @default("planogramy-2026")
  wersja    Int      @default(2)
  dane      Json

  @@index([ankieta])
}
